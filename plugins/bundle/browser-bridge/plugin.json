{
  "id": "browser-bridge",
  "name": "Chrome",
  "version": "0.1.0",
  "type": "general",
  "description": "Connect QwenPaw to this Chrome browser.",
  "author": "QwenPaw",
  "icon": "Chrome",
  "qwenpaw_version": {
    "min": "2.0.0"
  },
  "capabilities": [
    {
      "id": "browser-bridge",
      "name": "Chrome",
      "description": "Use QwenPaw with this Chrome browser."
    }
  ],
  "setup": {
    "kind": "native-messaging",
    "route": "/plugin/browser-bridge",
    "requires": [
      "chrome-extension",
      "native-messaging-host"
    ]
  },
  "meta": {
    "builtin": true
  },
  "entry": {
    "backend": "main.py",
    "frontend": "dist/index.js"
  },
  "dependencies": [],
  "min_version": "1.1.7"
}
