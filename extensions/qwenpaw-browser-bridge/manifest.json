{
  "manifest_version": 3,
  "name": "QwenPaw Browser Bridge",
  "version": "0.1.0",
  "description": "Local-only Chrome bridge for QwenPaw browser takeover mode.",
  "key": "",
  "permissions": [
    "nativeMessaging",
    "debugger",
    "tabs",
    "scripting",
    "activeTab",
    "alarms",
    "storage",
    "tabGroups",
    "webNavigation"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "service_worker.js"
  },
  "action": {
    "default_title": "QwenPaw Browser Bridge",
    "default_popup": "popup/popup.html"
  }
}
